{
  "name": "CampusFlow Webhook Reminders",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "campusflow-reminders",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "campusflow-reminders-webhook"
    },
    {
      "parameters": {
        "chatId": "={{ $json.body.telegram_chat_id }}",
        "text": "={{ $json.body.message_text }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-telegram",
      "name": "Send Telegram Reminder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [
        550,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "h2Q6l1bxyZuXkLTL",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Send Telegram Reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "notifyme"
    }
  ]
}
